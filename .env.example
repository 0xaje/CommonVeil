# Midnight Preprod Indexer Configuration (Blockfrost Preprod Override)
#
# To override the wallet-provided indexer with Blockfrost Preprod,
# set both VITE_INDEXER_URI and VITE_INDEXER_WS_URI with your project token.
# Replace YOUR_MIDNIGHT_PREPROD_PROJECT_ID with your actual Blockfrost project ID.
# DO NOT commit real tokens to version control.

VITE_INDEXER_URI=https://midnight-preprod.blockfrost.io/api/v0?project_id=YOUR_MIDNIGHT_PREPROD_PROJECT_ID
VITE_INDEXER_WS_URI=wss://midnight-preprod.blockfrost.io/api/v0/ws?project_id=YOUR_MIDNIGHT_PREPROD_PROJECT_ID
